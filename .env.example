# ===== 向量库配置（Milvus）=====
MILVUS_HOST=<your-milvus-host>
MILVUS_PORT=19530
MILVUS_COLLECTION=mining_rag_collection

# ===== 上下文记忆存储（MongoDB）=====
MONGO_HOST=<your-mongo-host>
MONGO_PORT=27017
MONGO_DB=mining_rag_memory

# ===== Embedding模型配置 =====
EMBED_MODEL_NAME=BAAI/bge-small-en-v1.5
EMBED_DEVICE=cpu

# ===== LLM 配置（DeepSeek，用于RAG生成回答 + faithfulness评估）=====
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=<your-deepseek-api-key>
LLM_MODEL_NAME=deepseek-chat

# ===== 项目文件路径配置 =====
RAW_NEWS_PATH=pipeline/crawlers/news_raw.json
RAW_POLICY_PATH=pipeline/crawlers/policy_raw.json
RAW_PRICE_PATH=pipeline/crawlers/price_raw.json
CLEANED_DOCS_PATH=pipeline/cleaned_docs.json
CHUNK_EMBEDS_PATH=pipeline/chunk_embeds.json

# ===== 爬虫/时间参数 =====
TIME_WINDOW_DAYS=30
CHUNK_SIZE=800
CHUNK_OVERLAP=150
RETRIEVE_TOP_K=5

# ===== 评估配置 =====
EVAL_QUERY_URL=http://localhost:8000/query
